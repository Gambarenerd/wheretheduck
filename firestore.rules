rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;

      // Personal groups (only owner can read/write)
      match /groups/{groupId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Contacts (only owner can read/write)
      match /contacts/{contactId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Contact invites (readable by sender or receiver)
    match /contact_invites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if false; // only via cloud functions
    }

    match /alerts/{alertId} {
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if false;
      allow update: if request.auth != null && resource.data.toUserId == request.auth.uid;
    }

    match /rateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
