rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{fileName} {
      // Anyone authenticated can read profile photos
      allow read: if request.auth != null;
      // Only the owner can upload their own photo (fileName = userId.jpg)
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /group_photos/{userId}/{fileName} {
      // Anyone authenticated can read group photos
      allow read: if request.auth != null;
      // Only the owner can upload to their own folder
      allow write: if request.auth != null
                   && userId == request.auth.uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
